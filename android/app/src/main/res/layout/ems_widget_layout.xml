<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Header & App Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EMS Duty Schedule"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/widget_weekly_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Week: 0%"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#4ADE80"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Weekly Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#4ADE80" />

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginBottom="8dp" />

    <!-- Duties Content: Today, Tomorrow, Upcoming -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Today's Duties -->
        <TextView
            android:id="@+id/widget_today_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODAY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8" />

        <TextView
            android:id="@+id/widget_today_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No duties scheduled for today."
            android:textSize="12sp"
            android:textColor="#E2E8F0"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="6dp" />

        <!-- Tomorrow's Duties -->
        <TextView
            android:id="@+id/widget_tomorrow_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOMORROW"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FBBF24" />

        <TextView
            android:id="@+id/widget_tomorrow_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No duties scheduled for tomorrow."
            android:textSize="12sp"
            android:textColor="#E2E8F0"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="6dp" />

        <!-- Next 7 Days Summary -->
        <TextView
            android:id="@+id/widget_upcoming_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upcoming: 0 duties next 7 days"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
